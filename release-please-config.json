{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "packages": {
    "packages/bpmn-studio": {
      "release-type": "node",
      "component": "bpmn-studio",
      "package-name": "@camunda8/bpmn-studio",
      "release-as": "0.1.0",
      "extra-files": [
        { "type": "json", "path": "/plugins/bpmn-studio/.claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "/.claude-plugin/marketplace.json", "jsonpath": "$.plugins[?(@.name=='bpmn-studio')].version" },
        { "type": "json", "path": "/.github/plugin/marketplace.json", "jsonpath": "$.plugins[?(@.name=='bpmn-studio')].version" }
      ]
    }
  }
}
